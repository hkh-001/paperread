# Copy to .env and fill values. Do not add /chat/completions to the base URL.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model-id
# OpenAI Chat Completions uses max_completion_tokens; some compatible services use max_tokens.
LLM_TOKEN_FIELD=max_completion_tokens
# Set omit if your model does not support temperature. Do not change between groups.
LLM_TEMPERATURE=0
# Optional proxy; only needed if your network requires it.
# HTTPS_PROXY=http://127.0.0.1:9567
